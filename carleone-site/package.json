{
  "name": "carleone-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/images.mjs && node scripts/lion.mjs && node scripts/globe-data.mjs && node scripts/fonts.mjs",
    "renders": "node scripts/render-globe.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs web",
    "build:single": "node scripts/build.mjs single",
    "build:all": "tsc -p tsconfig.json && node scripts/build.mjs web && node scripts/build.mjs single",
    "build:release": "tsc -p tsconfig.json && node scripts/build.mjs web --release && node scripts/build.mjs single --release",
    "preview": "vite preview --outDir dist",
    "qa:shots": "node scripts/qa/shots.mjs",
    "qa:check": "node scripts/qa/links.mjs --seo",
    "qa:interact": "node scripts/qa/interact.mjs",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "lightningcss": "^1.33.0",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.28",
    "potrace": "^2.1.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "world-atlas": "^2.0.2"
  }
}
